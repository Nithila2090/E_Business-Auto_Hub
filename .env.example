# =============================================================================
# AUTO HUB - Environment Configuration (.env)
# Rename this file to .env and set your local credentials
# DO NOT commit the .env file to GitHub or public repositories
# =============================================================================

# Application Mode: sandbox or live
PAYHERE_MODE=sandbox

# PayHere Merchant Credentials (from sandbox.payhere.lk or payhere.lk)
PAYHERE_MERCHANT_ID=1238344
PAYHERE_MERCHANT_SECRET=YOUR_PAYHERE_MERCHANT_SECRET_HERE

# Currency
PAYHERE_CURRENCY=LKR

# (Optional) Public HTTPS Tunnel URL for receiving real webhook callbacks on localhost
# Example: PAYHERE_PUBLIC_URL=https://my-autohub-tunnel.ngrok-free.app/EBusiness_Project
PAYHERE_PUBLIC_URL=

# (Optional) Direct Webhook Notification URL override
# Example: PAYHERE_NOTIFY_URL=https://my-autohub-tunnel.ngrok-free.app/EBusiness_Project/payment/notify.php
PAYHERE_NOTIFY_URL=
